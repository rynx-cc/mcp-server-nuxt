{
  "name": "mcp-server-nuxt",
  "version": "0.3.0",
  "description": "MCP server for Nuxt projects — exposes routes, components, config, and more to AI agents",
  "type": "module",
  "bin": {
    "mcp-server-nuxt": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external @nuxt/kit",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "tsx scripts/e2e-client.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "nuxt",
    "vue",
    "ai",
    "claude",
    "cursor",
    "nitro"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rynx-cc/mcp-server-nuxt.git"
  },
  "homepage": "https://github.com/rynx-cc/mcp-server-nuxt#readme",
  "bugs": {
    "url": "https://github.com/rynx-cc/mcp-server-nuxt/issues"
  },
  "author": "rynx-cc",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "fast-glob": "^3.3.0",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "@nuxt/kit": "^3.14.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
